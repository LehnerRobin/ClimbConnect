# Vorlage für die Docker-Konfiguration.
# Diese Datei nach ".env" kopieren und den Wert ersetzen. Die ".env" wird nicht ins Repo committet.

# Geheimer Schlüssel zum Signieren der Login-Tokens (mindestens 32 Zeichen)
JWT_KEY=hier-einen-eigenen-geheimen-schluessel-mit-mindestens-32-zeichen

# Passwort für den Admin (admin@climbconnect.at), mindestens 12 Zeichen.
# Wird nur beim allerersten Start mit leerer Datenbank verwendet.
SEED_ADMIN_PASSWORD=hier-ein-eigenes-admin-passwort
